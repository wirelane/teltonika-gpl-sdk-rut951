#include "mt7621-teltonika-common.dtsi"
#include "mt7621-teltonika-rutm-flash.dtsi"

/ {
	compatible = "teltonika,teg100", "mediatek,mt7621-soc";
	model = "Teltonika TEG100";

	ext_io {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;

		sck-gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;	// 74HC595 SRCLK (Serial Clock)
		mosi-gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;	// 74HC595 SER (Serial)
		cs-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;	// 74HC595 RCLK (Register Clock)
		num-chipselects = <1>;

		shift_io: shift_io@0 {
			compatible = "fairchild,74hc595";
			reg = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			registers-number = <2>;
			spi-max-frequency = <10000000>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	gpio-export {
		compatible = "gpio-export";
		#size-cells = <0>;

		gpio_modem_reset {
			gpio-export,name = "modem_reset";
			gpio-export,output = <0>;
			gpios = <&gpio 45 GPIO_ACTIVE_HIGH>;
		};

		gpio_modem_power {
			gpio-export,name = "modem_power";
			gpio-export,output = <0>;
			gpios = <&gpio 41 GPIO_ACTIVE_HIGH>;
		};

		gpio_sim_select {
			gpio-export,name = "sim_sel";
			gpio-export,output = <0>;
			gpios = <&shift_io 7 GPIO_ACTIVE_HIGH>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power {
			label = "power";
			gpios = <&shift_io 0 GPIO_ACTIVE_LOW>;
			default-state = "on";
			retain-state-shutdown;
		};

		led_gen_blue {
			label = "mob_gen_blue";
			gpios = <&switch0 0 GPIO_ACTIVE_LOW>; // P0_LED0
		};

		led_gen_green {
			label = "mob_gen_green";
			gpios = <&shift_io 5 GPIO_ACTIVE_LOW>;
		};

		led_gen_red {
			label = "mob_gen_red";
			gpios = <&shift_io 6 GPIO_ACTIVE_HIGH>;
		};

		led_eth_y {
			label = "eth_y";
			gpios = <&gpio 42 GPIO_ACTIVE_HIGH>;
		};

		led_eth_g {
			label = "eth_g";
			gpios = <&gpio 43 GPIO_ACTIVE_HIGH>;
		};

		led_eth {
			label = "eth_act";
			gpios = <&switch0 3 GPIO_ACTIVE_LOW>;
		};

		led_ssid_red {
			label = "mob_ssid_red";
			gpios = <&switch0 12 GPIO_ACTIVE_LOW>; // P4_LED0
			linux,default-trigger = "timer"; // only
		};

		led_ssid_green {
			gpios = <&shift_io 4 GPIO_ACTIVE_LOW>;
			label = "mob_ssid_green";
			linux,default-trigger = "timer"; //only
		};

		led_ssid_blue {
			label = "mob_ssid_blue";
			gpios = <&switch0 6 GPIO_ACTIVE_LOW>; // P2_LED0
			linux,default-trigger = "timer"; // only
		};
	};

	tlt_gpios { // Modify according to wiki page "DTS syntax with Libgpiod changes"
		gpiochip_info {
			hw_0 {
				hwver = <0>;
				gpiochip_count = <5>;

				gpiochip_0 = <32>; // Built-in
				gpiochip_1 = <32>; // Built-in
				gpiochip_2 = <32>; // Built-in
				gpiochip_3 = <24>; // Shift Register
				gpiochip_4 = <15>; // MT7530 switch GPIO
			};
		};

		ioman {
			GPIO_18 {
				line_name = "GPIO_IN_1";
			};
			GPIO_16 {
				line_name = "GPIO_IN_2";
			};
			GPIO_15 {
				line_name = "GPIO_IN_3";
			};
			GPIO_99 {
				line_name = "GPIO_OUT_1";
			};
			GPIO_98 {
				line_name = "GPIO_OUT_2";
			};
			GPIO_97 {
				line_name = "GPIO_OUT_3";
			};
			GPIO_44 {
				line_name = "GPIO_RELAY_CLOSE_1";
			};
		};

		misc {
			GPIO_45 {
				line_name = "GPIO_MODEM_RESET_1";
			};
			GPIO_7 {
				line_name = "GPIO_SIM_SELECT";
			};
			GPIO_40 {
				line_name = "GPIO_MODEM_POWER_1";
			};
		};
	};

	ioman {
		layout@0 {
			io@0 {
				label = "dio0";
				block_type = BLOCK_6PIN;
				block_pin = "2";
				default_direction = "out";
				gpio_in = "GPIO_IN_1";
				gpio_out = "GPIO_OUT_1";
				io_param = "g0";
			};
			io@1 {
				label = "dio1";
				block_type = BLOCK_6PIN;
				block_pin = "3";
				default_direction = "out";
				gpio_in = "GPIO_IN_3";
				gpio_out = "GPIO_OUT_3";
				io_param = "g2";
			};
			io@2 {
				label = "dio2";
				block_type = BLOCK_6PIN;
				block_pin = "5";
				default_direction = "out";
				gpio_in = "GPIO_IN_2";
				gpio_out = "GPIO_OUT_2";
				io_param = "g1";
			};
			relay@0 {
				label = "relay0";
				block_type = BLOCK_6PIN;
				block_pin = "1,4";
				gpio_close = "GPIO_RELAY_CLOSE_1";
				io_param = "g3";
			};
			adc@0 {
					label = "bat0";
					block_type = BLOCK_2PIN;
					block_pin = "1";
					web_str = "Battery Voltage";
					tolerance = "0.01";
					io_param = "g4";

					adc_cof@0 {
						port = "0";
						multiplier = "0.015949821";
					};
			};
		};
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	spi_proslic {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;

		sck-gpios = <&gpio 5 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpio 7 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpio 8 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
		num-chipselects = <1>;

		proslic_spi: proslic_spi@0 {
			compatible = "proslic,si3218x";
			reg = <0>;
			#sound-dai-cells = <0>;
			spi-max-frequency = <500000>;
			spi-cpha = <1>;
			spi-cpol = <1>;
			channel_count = <1>;
			debug_level = <4>;       /* 1 = TRC, 2 = DBG, 4 = ERR */
			reset-gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
			irq-gpios = <&gpio 46 GPIO_ACTIVE_LOW>;
		};
	};

	sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "Audio-PCM";

		simple-audio-card,dai-link@0 {
			format = "dsp_a";
			bitclock-master = <&snd_cpu>;
			frame-master = <&snd_cpu>;

			snd_cpu: cpu {
				sound-dai = <&pcm>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <16>;
			};

			snd_codec: codec {
				sound-dai = <&proslic_spi>;
			};
		};

	};

};

&pcm {
	status = "okay";
	#sound-dai-cells = <0>;
	mediatek,clock-keepalive;
	pinctrl-names = "default";
	pinctrl-0 = <&pcm_pins>;
};

&gdma {
    status="okay";
};


&state_default {
	gpio {
		groups = "wdt", "jtag", "uart3";
		function = "gpio";
	};
};

&xhci {
        status = "okay";
};

&sdhci {
        status = "disabled";
};

&switch0 {
	gpio-controller;
	#gpio-cells = <2>;

	ports {
		port@1 {
			status = "okay";
			label = "lan1";
		};
	};
};

&mnfinfo {
	sim_cfg {
		default = "0110000";
	};
};
