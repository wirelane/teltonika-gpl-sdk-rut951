#!/bin/sh /etc/rc.common

START=50
USE_PROCD=1
PROG="/usr/bin/qos-wfq"
[ -x "$PROG" ] || PROG="/usr/local$PROG"

service_triggers()
{
	procd_add_reload_trigger "wfq"
	procd_add_raw_trigger "interface.*.up" 2000 /etc/init.d/wfq reload
}

start_service() {
	procd_open_instance
	procd_set_param command $PROG
	procd_append_param command start
	procd_close_instance
}

stop_service() {
	$PROG stop
}

reload_service() {
	stop
	start
}
