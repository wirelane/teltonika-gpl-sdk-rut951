#!/bin/sh
case "$1" in
    start)
    GENERATE_PROG="/usr/lib/wfq/wfq.sh"
    [ -x "$GENERATE_PROG" ] || GENERATE_PROG="/usr/local$GENERATE_PROG"
    $GENERATE_PROG start | sh
    ;;

    stop)
	GENERATE_PROG="/usr/lib/wfq/wfq.sh"
	[ -x "$GENERATE_PROG" ] || GENERATE_PROG="/usr/local$GENERATE_PROG"
    $GENERATE_PROG stop | sh
    ;;
esac
