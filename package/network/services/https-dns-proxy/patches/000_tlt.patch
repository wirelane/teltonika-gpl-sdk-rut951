+    case CURL_HTTP_VERSION_1_1:
+      return "1.1";
+    case CURL_HTTP_VERSION_2_0: // fallthrough
+    case CURL_HTTP_VERSION_2TLS:
+      return "2";
+#ifdef CURL_VERSION_HTTP3
+    case CURL_HTTP_VERSION_3:
+      return "3";
+#endif
+    default:
+      FLOG("Unsupported HTTP version: %d", version);
+  }
