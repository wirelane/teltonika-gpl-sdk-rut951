+++ busybox-1.34.1/loginutils/login.c
@@ -53,6 +53,11 @@
 //config:	default y
 //config:	depends on LOGIN
 //config:
+//config:config FEATURE_2FA
+//config:	bool "Support for 2FA"
+//config:	default y
