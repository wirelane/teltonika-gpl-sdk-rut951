Index: busybox-1.34.1/loginutils/pw_policy.c
===================================================================
--- /dev/null
+++ busybox-1.34.1/loginutils/pw_policy.c
@@ -0,0 +1,197 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * pw_policy.c - shared helpers for the password policy feature
+ */
+//kbuild:lib-$(CONFIG_FEATURE_PASSWORD_POLICY) += pw_policy.o
+
+#include "libbb.h"
+#include "pw_policy.h"
+
+#if ENABLE_FEATURE_PASSWORD_POLICY
+#include <uci.h>
+
+#define OPASSWD_FILE "/etc/security/opasswd"
+
+static long lookup_policy_long(struct uci_context *ctx, const char *option, int *valid)
+{
+	struct uci_ptr ptr;
+	char uci_path[64];
+	char *endptr;
+	long value;
+
+	*valid = 0;
+	snprintf(uci_path, sizeof(uci_path), "password_policy.@policy[0].%s", option);
+	if (uci_lookup_ptr(ctx, &ptr, uci_path, true) != UCI_OK || !ptr.o || !ptr.o->v.string)
+		return 0;
+	value = strtol(ptr.o->v.string, &endptr, 10);
+	if (*endptr != '\0')
+		return 0;
+	*valid = 1;
+	return value;
+}
+
+int pw_policy_get_int(struct uci_context *ctx, const char *option, int default_value)
+{
+	int valid;
+	long value = lookup_policy_long(ctx, option, &valid);
+
+	if (!valid || value < INT_MIN || value > INT_MAX)
+		return default_value;
+	return (int)value;
+}
+
+int pw_policy_get_bool(struct uci_context *ctx, const char *option, int default_value)
+{
+	int valid;
+	long value = lookup_policy_long(ctx, option, &valid);
+
+	if (!valid || value < 0 || value > 1)
+		return default_value;
+	return (int)value;
+}
+
+int pw_policy_history_count(void)
+{
+	struct uci_context *ctx;
+	int n;
+
+	ctx = uci_alloc_context();
+	if (!ctx)
+		return 0;
+	n = pw_policy_get_int(ctx, "password_history", 0);
+	uci_free_context(ctx);
+	return n;
+}
+
+int pw_policy_in_history(const char *name, const char *newval)
+{
+	FILE *fp;
+	char *line;
+	size_t namelen = strlen(name);
+	int reused = 0;
+	int remember = pw_policy_history_count();
+
+	if (remember <= 0)
+		return 0;
+
+	fp = fopen(OPASSWD_FILE, "r");
+	if (!fp)
+		return 0;
+
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		char *hashes, *saveptr, *h;
+		int checked = 0;
+
+		// Match "name:" at the start of the line
+		if (strncmp(line, name, namelen) != 0 || line[namelen] != ':') {
+			free(line);
+			continue;
+		}
+
+		// Skip the uid and count fields to reach the hash list
+		hashes = strchr(line + namelen + 1, ':');
+		hashes = hashes ? strchr(hashes + 1, ':') : NULL;
+		if (!hashes) {
+			free(line);
+			break;
+		}
+		hashes++;
+
+		for (h = strtok_r(hashes, ",", &saveptr); h && checked < remember; h = strtok_r(NULL, ",", &saveptr)) {
+			char *enc = pw_encrypt(newval, h, 1);
+			if (enc) {
+				if (strcmp(enc, h) == 0)
+					reused = 1;
+				if (ENABLE_FEATURE_CLEAN_UP)
+					free(enc);
+			}
+			if (reused)
+				break;
+			checked++;
+		}
+		free(line);
+		break;
+	}
+
+	fclose(fp);
+	return reused;
+}
+
+void pw_policy_save_history(const char *name, uid_t uid, const char *old_hash)
+{
+	FILE *in, *out;
+	char *line;
+	char *newlist;
+	char *old_list = NULL;
+	size_t namelen = strlen(name);
+	char tmpname[] = "/etc/security/.opasswd.XXXXXX";
+	int fd, count;
+	int remember = pw_policy_history_count();
+	struct stat st;
+
+	if (remember <= 0 || !old_hash || !old_hash[0])
+		return;
+
+	// Nothing meaningful to remember for empty/locked/shadowed entries
+	if (old_hash[0] == 'x' || old_hash[0] == '!' || old_hash[0] == '*')
+		return;
+
+	fd = mkstemp(tmpname);
+	if (fd < 0)
+		return;
+
+	if (stat(OPASSWD_FILE, &st) == 0) {
+		fchown(fd, st.st_uid, st.st_gid);
+		fchmod(fd, st.st_mode & 07777);
+	}
+
+	out = fdopen(fd, "w");
+	if (!out) {
+		close(fd);
+		unlink(tmpname);
+		return;
+	}
+
+	in = fopen(OPASSWD_FILE, "r");
+	if (in) {
+		while ((line = xmalloc_fgetline(in)) != NULL) {
+			if (strncmp(line, name, namelen) == 0 && line[namelen] == ':') {
+				// Our record: keep its existing hash list
+				char *p = strchr(line + namelen + 1, ':');
+				p = p ? strchr(p + 1, ':') : NULL;
+				if (p && p[1])
+					old_list = xstrdup(p + 1);
+				free(line);
+				continue;
+			}
+			fputs(line, out);
+			fputc('\n', out);
+			free(line);
+		}
+		fclose(in);
+	}
+
+	// Build the new list: old_hash first, then previous entries
+	newlist = xstrdup(old_hash);
+	count = 1;
+	if (old_list) {
+		char *saveptr, *h;
+		for (h = strtok_r(old_list, ",", &saveptr);
+		     h && count < remember;
+		     h = strtok_r(NULL, ",", &saveptr)) {
+			char *tmp = xasprintf("%s,%s", newlist, h);
+			free(newlist);
+			newlist = tmp;
+			count++;
+		}
+		free(old_list);
+	}
+
+	fprintf(out, "%s:%lu:%d:%s\n", name, (unsigned long)uid, count, newlist);
+	free(newlist);
+	fclose(out);
+
+	if (rename(tmpname, OPASSWD_FILE) != 0)
+		unlink(tmpname);
+}
+#endif // ENABLE_FEATURE_PASSWORD_POLICY
