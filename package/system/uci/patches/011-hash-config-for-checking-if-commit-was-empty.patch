+static unsigned int uci_hash_option(unsigned int hash, struct uci_option *option)
+{
+	hash = djbhash_str(hash, option->e.name);
+
+	switch(option->type) {
+	case UCI_TYPE_STRING:
+		hash = djbhash_str(hash, option->v.string);
+		break;
+	case UCI_TYPE_LIST: {
+		uint32_t value_count = 0;
+		struct uci_element *e = NULL;
+		uci_foreach_element(&option->v.list, e) {
+			hash = djbhash_str(hash, e->name);
+		}
+		hash = djbhash(hash, (uint8_t*)&value_count, sizeof(value_count));
+		break;
+	} default:
+		break;
+	}
+
+	return hash;
+}
+
+static unsigned int uci_hash_section(unsigned int hash, struct uci_section *section)
+{
+	uint32_t option_count = 0;
+
+	struct uci_element *e = NULL;
+	uci_foreach_element(&section->options, e) {
+		hash = uci_hash_option(hash, uci_to_option(e));
+		option_count += 1;
+	}
+
+	hash = djbhash(hash, (uint8_t*)&option_count, sizeof(option_count));
+	hash = djbhash(hash, (uint8_t*)&section->anonymous, sizeof(section->anonymous));
+	hash = djbhash_str(hash, section->e.name);
+	hash = djbhash_str(hash, section->type);
+
+	return hash;
+}
+
+static unsigned int uci_hash_package(unsigned int hash, struct uci_package *package)
+{
+	uint32_t section_count = 0;
+
+	struct uci_element *e = NULL;
+	uci_foreach_element(&package->sections, e) {
+		hash = uci_hash_section(hash, uci_to_section(e));
+		section_count += 1; 
+	}
+
+	hash = djbhash(hash, (uint8_t*)&section_count, sizeof(section_count));
+	hash = djbhash_str(hash, package->e.name);
+
+	return hash;
+}
