+/* Based on an efficient hash function published by D. J. Bernstein */
+__private unsigned int djbhash(unsigned int hash, uint8_t *buff, size_t buff_len)
+{
+	if (hash == DBJHASH_INITIAL)
+		hash = 5381;
+
+	for(size_t i = 0; i < buff_len; i++) {
+		hash = ((hash << 5) + hash) + buff[i];
+	}
+	return (hash & 0x7FFFFFFF);
+}
+
+__private unsigned int djbhash_str(unsigned int hash, char *str)
+{
+	if (str != NULL) {
+		hash = djbhash(hash, (uint8_t*)str, strlen(str));
+	}
+	return hash;
+}
