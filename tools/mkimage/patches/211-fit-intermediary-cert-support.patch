+static int fit_certificate_get_data(void *fit, int sig_noffset,
+		struct image_region **regionp, int *region_countp,
+		char **region_propp, int *region_proplen)
+{
+	char * const exc_prop[] = {"data"};
+	struct strlist node_inc;
+	struct image_region *region;
+	struct fdt_region fdt_regions[100];
+	char name[200], path[200];
+	int count, i;
+	char *region_prop;
+	int len;
+	int key_noffset = -1;
+
+	strlist_init(&node_inc);
+
+	key_noffset = fdt_first_subnode(fit, sig_noffset);
+	if (key_noffset < 0)
+		return FDT_ERR_NOTFOUND;
+
+	snprintf(name, sizeof(name), "/signature/%s", fdt_get_name(fit, key_noffset, NULL));
+	if (strlist_add(&node_inc, name)) {
+		printf("Out of memory processing fit certificate\n");
+		return -ENOMEM;
+	}
+
+	/* Get a list of regions to hash */
+	count = fdt_find_regions(fit, node_inc.strings, node_inc.count,
+			exc_prop, ARRAY_SIZE(exc_prop),
+			fdt_regions, ARRAY_SIZE(fdt_regions),
+			path, sizeof(path), 1);
+	if (count < 0) {
+		printf("Failed to hash pubkey '%s'\n", name);
+		return -EIO;
+	}
+	if (count == 0) {
+		printf("No data to hash for pubkey '%s\n", name);
+		return -EINVAL;
+	}
+
+	/* Build our list of data blocks */
+	region = fit_region_make_list(fit, fdt_regions, count, NULL);
+	if (!region) {
+		printf("Out of memory hashing pubkey '%s'\n", name);
+		return -ENOMEM;
+	}
+
+	/* Create a list of all hashed properties */
+	debug("Hash nodes:\n");
+	for (i = len = 0; i < node_inc.count; i++) {
+		debug("   %s\n", node_inc.strings[i]);
+		len += strlen(node_inc.strings[i]) + 1;
+	}
+	region_prop = malloc(len);
+	if (!region_prop) {
+		printf("Out of memory setting up regions for pubkey '%s'\n", name);
+		return -ENOMEM;
+	}
+	for (i = len = 0; i < node_inc.count;
+	     len += strlen(node_inc.strings[i]) + 1, i++)
+		strcpy(region_prop + len, node_inc.strings[i]);
+	strlist_free(&node_inc);
+
+	*region_countp = count;
+	*regionp = region;
+	*region_propp = region_prop;
+	*region_proplen = len;
+
+	return 0;
+}
+
+static int fit_certificate_add_verification_data(const char *keydir,
+		void *fit, int require_keys, int sig_noffset, const char* sign_key_name, const char *sign_key_algo,
+		const char *comment, const char *cmdname)
+{
+	const char *node_name;
+	struct image_region *region;
+	char *region_prop;
+	int region_proplen;
+	int region_count;
+	uint8_t *value;
+	uint value_len;
+	int ret;
+	struct image_sign_info info;
+
+	node_name = fit_get_name(fit, sig_noffset, NULL);
+	if (fit_certificate_get_data(fit, sig_noffset, &region,
+				&region_count, &region_prop, &region_proplen))
+		return -1;
+
+	info.keyname = sign_key_name;
+	info.name = sign_key_algo;
+	info.crypto = image_get_crypto_algo(sign_key_algo);
+	info.keydir = keydir;
+	info.require_keys = require_keys ? "conf" : NULL;
+	info.node_offset = sig_noffset;
+	info.checksum = image_get_checksum_algo(info.name);
+
+	if (!info.checksum || !info.crypto) {
+		printf("Unsupported signature algorithm (%s) for '%s'\n",
+		       info.name, node_name);
+		return -1;
+	}
+
+	ret = info.crypto->sign(&info, region, region_count, &value,
+				&value_len);
+	free(region);
+	if (ret) {
+		printf("Failed to sign '%s' signature node fit certificate signture node\n", node_name);
+		return -1;
+	}
+
+	ret = fit_image_write_sig(fit, sig_noffset, value, value_len, comment,
+				region_prop, region_proplen, cmdname);
+	if (ret) {
+		if (ret == -FDT_ERR_NOSPACE)
+			return -ENOSPC;
+		printf("Can't write signature for '%s' signature node certificate node: %s\n", node_name, fdt_strerror(ret));
+		return -1;
+	}
+	free(value);
+	free(region_prop);
+
+	return 0;
+}
+
+int fit_add_certificate_data(void *fit, const char* keydir, int require_keys, const char *sign_key_name, const char *sign_key_algo)
+{
+	int ret;
+	int sig_noffset, noffset, conf_noffset;
+	struct image_sign_info info;
+	const char *key_name, *algo_name;
+
+	/* To include the right certificate, look at the information defined in the config node.
+		key-name-hint should be set, that certificate is what we're after. */
+	conf_noffset = fdt_path_offset(fit, FIT_CONFS_PATH);
+
+	if (conf_noffset < 0) {
+		debug("Can't find configuration node\n");
+		return conf_noffset;
+	}
+
+	/* Go through all config nodes, find first with valid signature info to get key values,
+		and insert cert + signature. Right now, we only configure a single signature node in
+		.its, so this works fine. Need to adjust to support multiple certificates.
+
+		Note: adding certificate node invalidates next fdt_next_subnode() call (returns -1), and it is not
+		possible to loop through next configs after successfull FDT modification. This is okay for
+		single FIT certificate.*/
+	for (noffset = fdt_first_subnode(fit, conf_noffset);
+		noffset >= 0;
+		noffset = fdt_next_subnode(fit, noffset)) {
+
+		/* First, find the signature node of config*/
+		sig_noffset = fdt_subnode_offset(fit, noffset, FIT_SIG_NODENAME);
+		if (sig_noffset < 0)
+			continue;
+
+		memset(&info, 0, sizeof(struct image_sign_info));
+		if (!(key_name = fdt_getprop(fit, sig_noffset, FIT_KEY_HINT, NULL)) ||
+				!(algo_name = fdt_getprop(fit, sig_noffset, FIT_ALGO_PROP, NULL))) {
+			debug("Error getting key name and algo properties from signature node in configuration\n");
+			return FDT_ERR_NOTFOUND;
+		}
+
+		info.keydir = keydir;
+		info.require_keys = require_keys ? "conf" : NULL;
+		info.crypto = image_get_crypto_algo(algo_name);
+
+		if (!info.crypto) {
+			printf("Unsupported signature algorithm (%s) for '%s'\n",
+				info.name, fit_get_name(fit, sig_noffset, NULL));
+			return -1;
+		}
+
+		/* Need to make a copy, using string from fdt_getprop() directly is bad
+		because add_verify_data() changes FIT and invalidates the pointers.*/
+		info.keyname = strdup(key_name);
+		info.name = strdup(algo_name);
+
+		/* Insert FIT public key parameters in FIT */
+		ret = info.crypto->add_verify_data(&info, fit);
+
+		free(info.keyname);
+		free(info.name);
+
+		if (ret) {
+			printf("Adding verification data failed: %d\n", ret);
+			return ret;
+		}
+
+		/* Find the signature node of the fit certificate, it's inserted after the root node.*/
+		sig_noffset = fdt_subnode_offset(fit, 0, FIT_SIG_NODENAME);
+		if (sig_noffset < 0) {
+			debug("Can't find certificate signature node.\n");
+			return -FDT_ERR_NOTFOUND;
+		}
+
+		/* Add FIT cert signing key information to the signature node*/
+		ret = fdt_setprop_string(fit, sig_noffset, FIT_ALGO_PROP, sign_key_algo);
+		ret |= fdt_setprop_string(fit, sig_noffset, FIT_KEY_HINT, sign_key_name);
+
+		return ret;
+	}
+
+	return 0;
+}
